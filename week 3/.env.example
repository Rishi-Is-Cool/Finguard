# Required — get a key from https://console.groq.com
GROQ_API_KEY=

# Optional — which Groq model to use. Groq retires models periodically;
# llama-3.1-8b-instant no longer exists. Default: openai/gpt-oss-20b
GROQ_MODEL=

# Optional — your fine-tuned model from HuggingFace Hub (Day 17, CELL_7).
# Must be the MERGED repo, not the LoRA adapter repo.
#   e.g. your-username/finguard-fraud-classifier-merged
# Needs a CUDA GPU with >=18 GB VRAM; otherwise the backend logs why and
# uses the Groq model above instead.
FINGUARD_MODEL_NAME=

# Optional — skip the hardware preflight and load the local model anyway.
FINGUARD_FORCE_LOCAL=

# Optional — how many top HIGH-severity transactions the ai_classifier agent
# sends to the model per analysis. Default: 5
FINGUARD_CLASSIFY_TOP_N=

# Optional — LangSmith tracing (carried over from Week 2)
LANGCHAIN_API_KEY=
