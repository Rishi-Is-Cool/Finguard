# ── Required ──────────────────────────────────────────────────────────────────
# https://console.groq.com — runs CRAG grading, escalations and the report.
GROQ_API_KEY=

# ── Optional: Jev screening (https://console.typesafe.ai/settings/keys) ──────
# Set it and every flagged transaction is screened by Jev; only the uncertain
# ones escalate to the LLM. Unset, the top-N HIGH flags go straight to the LLM.
TYPESAFE_API_KEY=
FINGUARD_JEV_CONFIDENCE=0.8      # accept Jev's verdict at or above this confidence
FINGUARD_SCREEN_MAX=300          # most transactions screened per analysis
FINGUARD_CLASSIFY_TOP_N=5        # LLM escalation budget per analysis

# ── Optional: models ──────────────────────────────────────────────────────────
GROQ_MODEL=                      # default openai/gpt-oss-20b (Groq retires models)
FINGUARD_MODEL_NAME=             # merged fine-tuned model; needs a >=18 GB CUDA GPU
FINGUARD_FORCE_LOCAL=            # 1 = skip the GPU capacity check

# ── Optional: deployment guards ───────────────────────────────────────────────
FINGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FINGUARD_MAX_UPLOAD_MB=5
FINGUARD_MAX_ROWS=5000
FINGUARD_RATE_LIMIT_PER_HOUR=20  # /analyze per client IP; 0 disables
FINGUARD_TRUSTED_PROXY_HOPS=1    # proxies in front of the app that append X-Forwarded-For
FINGUARD_AUDIT_DIR=              # default ./audit_logs

# ── Optional: tracing ─────────────────────────────────────────────────────────
LANGCHAIN_API_KEY=

# Frontend build-time (only for split deployments, e.g. frontend on Vercel):
# VITE_API_URL=https://your-backend.example.com
